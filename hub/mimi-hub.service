# mimi-hub as a systemd user service. Install:
#   cp hub/mimi-hub.service ~/.config/systemd/user/   # then edit WorkingDirectory / --host / Environment below
#   systemctl --user daemon-reload && systemctl --user enable --now mimi-hub
#   loginctl enable-linger "$USER"                     # keep it running when you're not logged in
#   journalctl --user -u mimi-hub -f                   # logs
# systemd doesn't allow comments after values, so every note is on its own line.

[Unit]
Description=mimi-hub (podcast -> .mimi + transcripts + ad marks)
After=network-online.target

[Service]
# where you cloned this repository (%h = your home directory)
WorkingDirectory=%h/neural_audio
# bind a private address (e.g. your Tailscale IP): the app sends no token, so don't expose this publicly
ExecStart=/usr/bin/env bash hub/serve.sh --host 127.0.0.1 --port 8765
# needs ffmpeg and uv on PATH, plus codex / claude for ad detection (or set MIMI_HUB_SEGMENTER=off)
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=MIMI_HUB_THREADS=16
# transcripts and ad marks only, no .mimi:
#Environment=MIMI_HUB_COMPRESS=0
Restart=on-failure
# keeps retrying until e.g. tailscaled has the address after boot
RestartSec=10
MemoryMax=24G

[Install]
WantedBy=default.target
